cmake_minimum_required(VERSION 3.16)

project(sai-record-youbai VERSION 1.0 LANGUAGES CXX)

set(CMAKE_AUTOUIC ON)
set(CMAKE_AUTOMOC ON)
set(CMAKE_AUTORCC ON)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

find_package(QT NAMES Qt6 Qt5 REQUIRED COMPONENTS Widgets Svg)
find_package(Qt${QT_VERSION_MAJOR} REQUIRED COMPONENTS Widgets Svg)



set(PROJECT_SOURCES
    main.cpp
    saiengine.cpp
    saiengine.h
    remoteptr.h
    videowriter.cpp
    videowriter.h
    mouselistener.cpp
    mouselistener.h
    settings.cpp
    settings.h

     sai_record_widget.h
    sai_record_widget.cpp

        resources.qrc

)

if(${QT_VERSION_MAJOR} GREATER_EQUAL 6)
    qt_add_executable(sai-record-youbai
        MANUAL_FINALIZATION
        ${PROJECT_SOURCES}
        sai_record_widget.h
        sai_record_widget.cpp
    )
else()
    add_executable(sai-record-youbai
        ${PROJECT_SOURCES}
    )
endif()

target_link_libraries(sai-record-youbai PRIVATE
    Qt${QT_VERSION_MAJOR}::Widgets
        Qt${QT_VERSION_MAJOR}::Svg

)

# Link Windows API libraries
if(WIN32)
    target_link_libraries(sai-record-youbai PRIVATE
        psapi.lib
        advapi32.lib
        user32.lib
        gdi32.lib
        msimg32.lib
    )
endif()

set_target_properties(sai-record-youbai PROPERTIES
    MACOSX_BUNDLE_GUI_IDENTIFIER com.youbai.sai-record-youbai
    MACOSX_BUNDLE_BUNDLE_VERSION ${PROJECT_VERSION}
    MACOSX_BUNDLE_SHORT_VERSION_STRING ${PROJECT_VERSION_MAJOR}.${PROJECT_VERSION_MINOR}
    MACOSX_BUNDLE TRUE
    WIN32_EXECUTABLE TRUE
)

include(GNUInstallDirs)
install(TARGETS sai-record-youbai
    BUNDLE DESTINATION .
    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
    RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
)

if(QT_VERSION_MAJOR EQUAL 6)
    qt_finalize_executable(sai-record-youbai)
endif()
